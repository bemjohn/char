<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <linearGradient id="darkTable" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1510"/>
      <stop offset="100%" style="stop-color:#0d0805"/>
    </linearGradient>
    <radialGradient id="spotlight" cx="50%" cy="30%" r="60%">
      <stop offset="0%" style="stop-color:#2a2015;stop-opacity:0.4"/>
      <stop offset="100%" style="stop-color:#0d0805;stop-opacity:0"/>
    </radialGradient>
    <filter id="noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
      <feComponentTransfer>
        <feFuncA type="table" tableValues="0 0.03"/>
      </feComponentTransfer>
    </filter>
  </defs>
  
  <rect width="1920" height="1080" fill="url(#darkTable)"/>
  <ellipse cx="960" cy="324" rx="700" ry="400" fill="url(#spotlight)"/>
  
  <g opacity="0.15" filter="url(#noise)">
    <rect width="1920" height="1080" fill="#3a2a1a"/>
  </g>
  
  <g transform="translate(200, 500)">
    <ellipse cx="0" cy="0" rx="280" ry="180" fill="#2d1a0d"/>
    <ellipse cx="0" cy="-20" rx="260" ry="160" fill="#3d2514"/>
    <path d="M-200,30 Q-150,10 -100,30 Q-50,50 0,30 Q50,10 100,30 Q150,50 200,30" fill="#5d3a1e" opacity="0.6"/>
    <ellipse cx="-120" cy="-40" rx="30" ry="20" fill="#8b5a2b"/>
    <ellipse cx="120" cy="-35" rx="28" ry="18" fill="#8b5a2b"/>
    <ellipse cx="0" cy="-50" rx="35" ry="22" fill="#8b5a2b"/>
    <path d="M-100,0 Q0,-80 100,0" stroke="#5d3a1e" stroke-width="8" fill="none" opacity="0.4"/>
    <ellipse cx="-80" cy="-60" rx="15" ry="8" fill="#c49a6c" opacity="0.5"/>
    <ellipse cx="80" cy="-55" rx="14" ry="7" fill="#c49a6c" opacity="0.5"/>
    <ellipse cx="0" cy="-70" rx="18" ry="9" fill="#c49a6c" opacity="0.5"/>
  </g>
  
  <g transform="translate(1400, 550)">
    <ellipse cx="0" cy="0" rx="200" ry="140" fill="#1f150d"/>
    <path d="M-180,20 Q-140,-10 -100,20 Q-60,50 0,20 Q60,-10 100,20 Q140,50 180,20" fill="#4a2c12" opacity="0.5"/>
    <ellipse cx="-120" cy="0" rx="35" ry="20" fill="#6b4423"/>
    <ellipse cx="120" cy="5" rx="33" ry="18" fill="#6b4423"/>
    <ellipse cx="0" cy="-10" rx="40" ry="22" fill="#6b4423"/>
    <path d="M-100,-20 Q0,-60 100,-20" stroke="#8b5a2b" stroke-width="6" fill="none" opacity="0.3"/>
  </g>
  
  <g transform="translate(600, 750)">
    <ellipse cx="0" cy="0" rx="150" ry="100" fill="#1a1a12"/>
    <ellipse cx="0" cy="-10" rx="130" ry="85" fill="#2a2a1a"/>
    <path d="M-100,15 Q-60,-5 -20,15 Q20,35 60,15 Q100,-5 140,15" fill="#3d3d25" opacity="0.4"/>
    <ellipse cx="-70" cy="0" rx="25" ry="15" fill="#5a4a1a"/>
    <ellipse cx="70" cy="5" rx="23" ry="13" fill="#5a4a1a"/>
    <ellipse cx="0" cy="-5" rx="28" ry="16" fill="#5a4a1a"/>
  </g>
  
  <g transform="translate(1100, 200)">
    <ellipse cx="0" cy="0" rx="180" ry="120" fill="#1a0f08"/>
    <ellipse cx="0" cy="-15" rx="160" ry="105" fill="#2d1a0f"/>
    <path d="M-140,20 Q-100,-20 -60,20 Q-20,60 20,20 Q60,-20 100,20 Q140,60 180,20" fill="#4a2c12" opacity="0.3"/>
    <ellipse cx="-90" cy="-10" rx="30" ry="18" fill="#7a4a1e"/>
    <ellipse cx="90" cy="-5" rx="28" ry="16" fill="#7a4a1e"/>
    <ellipse cx="0" cy="-20" rx="35" ry="20" fill="#7a4a1e"/>
  </g>
  
  <g transform="translate(300, 150)">
    <ellipse cx="0" cy="0" rx="220" ry="140" fill="#15100a"/>
    <ellipse cx="0" cy="-20" rx="200" ry="125" fill="#25180c"/>
    <path d="M-160,30 Q-120,-10 -80,30 Q-40,70 0,30 Q40,-10 80,30 Q120,70 160,30" fill="#3a250d" opacity="0.25"/>
    <ellipse cx="-100" cy="0" rx="35" ry="20" fill="#6a3d1a"/>
    <ellipse cx="100" cy="5" rx="33" ry="18" fill="#6a3d1a"/>
    <ellipse cx="0" cy="-10" rx="40" ry="22" fill="#6a3d1a"/>
  </g>
  
  <g transform="translate(1600, 100)">
    <ellipse cx="0" cy="0" rx="120" ry="80" fill="#181008"/>
    <ellipse cx="0" cy="-10" rx="105" ry="70" fill="#2a1a0a"/>
    <path d="M-80,15 Q-50,-5 -20,15 Q20,35 50,15 Q80,-5 110,15" fill="#3a250d" opacity="0.2"/>
    <ellipse cx="-50" cy="0" rx="20" ry="12" fill="#5a3515"/>
    <ellipse cx="50" cy="5" rx="18" ry="10" fill="#5a3515"/>
  </g>
  
  <g transform="translate(800, 900)">
    <ellipse cx="0" cy="0" rx="180" ry="100" fill="#120e08"/>
    <ellipse cx="0" cy="-10" rx="160" ry="85" fill="#22180c"/>
    <path d="M-120,20 Q-80,-10 -40,20 Q0,50 40,20 Q80,-10 120,20" fill="#35250c" opacity="0.2"/>
    <ellipse cx="-70" cy="5" rx="25" ry="14" fill="#5a3515"/>
    <ellipse cx="70" cy="10" rx="23" ry="12" fill="#5a3515"/>
  </g>
  
  <g transform="translate(1700, 800)">
    <ellipse cx="0" cy="0" rx="100" ry="60" fill="#100c06"/>
    <ellipse cx="0" cy="-5" rx="90" ry="50" fill="#1f150a"/>
    <ellipse cx="-40" cy="5" rx="18" ry="10" fill="#4a2a10"/>
    <ellipse cx="40" cy="8" rx="16" ry="8" fill="#4a2a10"/>
  </g>
  
  <g opacity="0.02">
    <rect width="1920" height="1080" fill="#1a1208"/>
  </g>
  
  <g transform="translate(500, 300)" opacity="0.08">
    <ellipse cx="0" cy="0" rx="400" ry="200" fill="#3a2510"/>
  </g>
</svg>